# Copy to `.env` (which is .gitignored) and edit for prod. All values
# have sensible dev defaults in docker-compose.yml; this file is the
# canonical list of what's safe to override.

# ── Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER=steelstore
POSTGRES_PASSWORD=steelstore
POSTGRES_DB=steelstore

# ── Backend ───────────────────────────────────────────────────────────
# Base64-encoded HS256 key (>= 32 bytes). Generate with:
#   openssl rand -base64 32
# The dev default is committed in application.yml; ALWAYS override in prod.
JWT_SECRET=

# Admin account. If ADMIN_PASSWORD is set, the backend ensures the
# `admin` row's hash matches this value on every boot (no-op if already
# matching). Leave blank to keep the seeded dev password (`admin`).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# CORS allow-list for the API. The bundled compose serves the frontend
# from http://localhost, so the default usually works; change if you
# expose the app on a different origin.
APP_CORS_ALLOWED_ORIGINS=http://localhost
